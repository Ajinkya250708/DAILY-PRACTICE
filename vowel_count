def vowel_count():
    text = input("Enter a word or sentence: ")
    vowels = "aeiouAEIOU"
    v = 0
    c = 0
    
    for i in text:
        if i.isalpha():
            if i in vowels:
                v += 1
            else:
                c += 1
    
    print("Vowels:" ,v)
    print("Consonants:",c)

vowel_count()